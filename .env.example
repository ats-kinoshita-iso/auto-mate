# auto-mate configuration. Copy to .env and adjust. All keys use the AUTOMATE_ prefix.

# --- External tool binaries (on PATH, or absolute paths to your forks) ---
AUTOMATE_TREEHOUSE_BIN=treehouse
AUTOMATE_NO_MISTAKES_BIN=no-mistakes

# firstmate is driven through its bin/ scripts, not a flag CLI. Point at a firstmate
# home directory (the checkout containing bin/fm-spawn.sh etc.). macOS/Linux only.
AUTOMATE_FIRSTMATE_HOME=

# --- Workspace + delivery ---
AUTOMATE_WORKSPACE_ROOT=~/.auto-mate
AUTOMATE_DEFAULT_BASE_REF=main

# --- Harness gates (optional; empty string disables the gate / auto-passes) ---
# governance: henkaten-council    codegen/eval: trine-eval
AUTOMATE_GOVERNANCE_CMD=
AUTOMATE_CODEGEN_CMD=

# --- Safety ---
# When true, every adapter echoes the command it would run instead of executing it.
AUTOMATE_DRY_RUN=true
