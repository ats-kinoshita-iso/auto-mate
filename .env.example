# auto-mate configuration. Copy to .env and adjust. All keys use the AUTOMATE_ prefix.

# --- External tool binaries (on PATH, or absolute paths to your forks) ---
AUTOMATE_TREEHOUSE_BIN=treehouse
AUTOMATE_NO_MISTAKES_BIN=no-mistakes

# --- Crew engine ---
# "direct" (default): run one agent harness in the worktree, anywhere.
# "firstmate": drive firstmate's bin/ scripts (macOS/Linux + tmux only).
AUTOMATE_CREW_BACKEND=direct
# Agent harness used by the "direct" crew backend.
# For real (non-dry) runs this must be HEADLESS and allowed to edit files, e.g.:
#   AUTOMATE_AGENT_CMD=claude -p --permission-mode acceptEdits --setting-sources project,local
# A bare interactive command would block waiting for a TTY.
# --setting-sources project,local keeps USER-scope plugins out of crew runs:
# plugin hooks otherwise write runtime state (.harness/, .council/) into the crew
# worktree, which the commit-leftovers step would sweep into the task's commit
# (caught live by the governance gate on 2026-08-06).
AUTOMATE_AGENT_CMD=claude
# firstmate home (the checkout with bin/fm-spawn.sh); used when CREW_BACKEND=firstmate.
AUTOMATE_FIRSTMATE_HOME=

# --- Workspace + delivery ---
AUTOMATE_WORKSPACE_ROOT=~/.auto-mate
AUTOMATE_DEFAULT_BASE_REF=main

# --- Harness gates (optional; empty string disables the gate / auto-passes) ---
# governance: henkaten-council    codegen/eval: trine-eval
# Each command is invoked as: <command> <task-id> <branch> <intent>, cwd = task repo.
# Reference implementations (headless claude reviews with a VERDICT protocol):
#   AUTOMATE_GOVERNANCE_CMD=bash /path/to/auto-mate/scripts/gates/governance.sh
#   AUTOMATE_CODEGEN_CMD=bash /path/to/auto-mate/scripts/gates/codegen.sh
AUTOMATE_GOVERNANCE_CMD=
AUTOMATE_CODEGEN_CMD=

# --- PR review (automate review) ---
# GitHub CLI binary; must be authenticated for the target repos.
AUTOMATE_GH_BIN=gh
# Remote repos given as owner/name are cloned here for review.
AUTOMATE_REVIEW_CLONE_ROOT=~/.auto-mate/repos
# Headless READ-ONLY agent for the deep review (explores the PR checkout).
# The allowlist keeps it read-only; --setting-sources keeps user plugins out.
AUTOMATE_REVIEW_AGENT_CMD=claude -p --setting-sources project,local --allowedTools "Read,Glob,Grep,Bash(git diff:*),Bash(git log:*),Bash(git show:*)"
AUTOMATE_REVIEW_TIMEOUT_S=1800
# Review engine for the deep review: prompt (intent-aware hand-rolled prompt)
# or code-review (Claude Code's native multi-pass /code-review skill).
AUTOMATE_REVIEW_ENGINE=prompt

# --- Cloud-runnable review backends (defaults keep gh + treehouse) ---
# git host: PR heads via refs/pull/N/head, clones over https, no gh needed.
# Metadata comes from the two vars below; --all/--post fail loudly on this host.
AUTOMATE_REVIEW_HOST=gh
# git host only: the PR's base branch, and its title (first line) + body (rest)
# for the gates to judge against.
AUTOMATE_REVIEW_BASE_REF=main
AUTOMATE_REVIEW_INTENT=
# Worktree backend: treehouse (pooling + leases) or git (plain git worktree,
# no extra binary - cloud-runnable). git worktrees are created under the root.
AUTOMATE_WORKTREE_BACKEND=treehouse
AUTOMATE_WORKTREE_ROOT=~/.auto-mate/worktrees

# --- Timeouts (seconds) ---
# Upper bounds for long-running externals; a hung run raises instead of blocking forever.
AUTOMATE_AGENT_TIMEOUT_S=3600
AUTOMATE_SHIP_TIMEOUT_S=3600
AUTOMATE_GATE_TIMEOUT_S=1800

# --- Safety ---
# When true, every adapter echoes the command it would run instead of executing it.
AUTOMATE_DRY_RUN=true
